{
  "uid": "headcount-live",
  "title": "Headcount live metrics",
  "tags": ["headcount"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Active sessions",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "max(headcount_active_sessions{job=\"headcount-app\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 2,
      "title": "Scans per second",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "sum(rate(headcount_scans_total[5m]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 3,
      "title": "Token rotations per second",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
      "targets": [{"expr": "sum(rate(headcount_token_rotations_total[5m]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 4,
      "title": "Healthy scrape targets",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0},
      "targets": [{"expr": "sum(up{job=~\"headcount-app|redis|postgres\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 5,
      "title": "Scan outcomes",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 6},
      "targets": [{"expr": "sum by (result) (rate(headcount_scans_total[5m]))", "legendFormat": "{{result}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 6,
      "title": "HTTP p95 latency by route",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 6},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (route, le) (rate(headcount_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 7,
      "title": "Rotation lag p95",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 15},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(headcount_rotation_lag_seconds_bucket[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 8,
      "title": "Rotator age by replica",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 15},
      "targets": [{"expr": "time() - headcount_rotator_last_iteration_timestamp_seconds{job=\"headcount-app\"}", "legendFormat": "{{instance}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 9,
      "title": "Rotator errors by operation",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "targets": [{"expr": "sum by (operation) (increase(headcount_rotator_errors_total[5m]))", "legendFormat": "{{operation}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 10,
      "title": "Redis and Postgres health",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "targets": [
        {"expr": "redis_up{job=\"redis\"}", "legendFormat": "Redis", "refId": "A"},
        {"expr": "pg_up{job=\"postgres\"}", "legendFormat": "Postgres", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "unit": "short"}},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    }
  ]
}
