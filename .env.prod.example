# Copy to .env.prod, chmod 600, and replace every placeholder before launch.
HEADCOUNT_DOMAIN=attendance.example.edu
PUBLIC_BASE_URL=https://attendance.example.edu
COOKIE_SECURE=true

POSTGRES_USER=headcount
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
POSTGRES_DB=headcount
# Percent-encode special characters in the password inside this URL.
DATABASE_URL=postgresql+asyncpg://headcount:REPLACE_WITH_RANDOM_PASSWORD@postgres:5432/headcount
REDIS_HOST=redis
REDIS_PORT=6379

OIDC_METADATA_URL=https://sso.example.edu/.well-known/openid-configuration
OIDC_CLIENT_ID=REPLACE_WITH_SCHOOL_CLIENT_ID
OIDC_CLIENT_SECRET=REPLACE_WITH_SCHOOL_CLIENT_SECRET
# For Google Workspace use {"hd":"school.edu"}; for Entra use {"tid":"TENANT_UUID"}.
OIDC_REQUIRED_CLAIMS_JSON=
AUTH_SESSION_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
GRAFANA_PORT=3001
